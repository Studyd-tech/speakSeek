# Set credentials securely in your shell or this ignored .env file.
BELWEAVE_API_KEY=
BELWEAVE_BASE_URL=https://api.infer.belweave.ai/v1
BELWEAVE_MODEL=Belweave/Kai-4
# Optional. Generated locally with mode 0600 when absent.
AGENTPULSE_INGEST_TOKEN=
AGENTPULSE_PORT=5177
# Optional absolute CLI location; defaults to notify on PATH.
NOTIFY_BIN=notify
# Real event alerts require explicit opt-in. Samples never send.
AGENTPULSE_NOTIFICATIONS=false
